# Copy this file to .env.local (never committed) and fill in the values.
# In production, set the same names in the host's environment settings (for Vercel:
# Project > Settings > Environment Variables).

# Final website address, no trailing slash. Used for the sitemap, canonical links and share previews.
SITE_URL=https://example.com

# Neon Postgres connection string: Neon console > your project > Connect (use the pooled one).
# Secret: it contains the password. Server code only; never put it in a NEXT_PUBLIC_ variable.
# Leave empty to run the site on the bundled content files (no database).
DATABASE_URL=

# Optional: the database owner's connection string, used only by `npm run db:migrate`.
# Set this if DATABASE_URL uses a limited login role (see DEPLOY.md). Never needed by the site itself.
MIGRATION_DATABASE_URL=
