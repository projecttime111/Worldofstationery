# Copy this file to .env.local (never committed) and fill in the values.
# In production, set the same names in the host's environment settings.

# Final website address, no trailing slash. Used for the sitemap, canonical links and share previews.
SITE_URL=https://example.com

# Supabase project: Project Settings > API (or `supabase status` for a local project).
# Leave both empty to run the site on the bundled content files (no database).
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (older projects call it the "anon" key). Safe in the browser:
# the database's Row Level Security rules decide what it may do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role (secret) key. Bypasses Row Level Security: server code only, never in the browser,
# never in a NEXT_PUBLIC_ variable. Not used until phase 2.
SUPABASE_SERVICE_ROLE_KEY=
